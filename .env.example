# Required: an OpenAI Admin API key with access to organisation usage and cost endpoints.
# This value is read only by Next.js server-side API routes. Never prefix it with NEXT_PUBLIC_.
OPENAI_ADMIN_API_KEY=sk-admin-...

# Optional: scope requests to a specific organisation or project when needed.
OPENAI_ORG_ID=org_...
OPENAI_PROJECT_ID=proj_...
